# =====================================================================
# VARIABLES DE ENTORNO — Backend Nextword
# =====================================================================

# ---- Conexión a Oracle Autonomous DB -------------------------------
# Alias TNS definido en oracle_wallet/tnsnames.ora.
# Recomendado: _low para desarrollo, _high para producción.
DB_CONNECT_STRING=preguntasrespuestasnwbd_low

# Usuario y contraseña de la base de datos 
DB_USER=ADMIN
DB_PASSWORD=

# Contraseña del WALLET: la que escribiste en OCI cuando descargue la
# wallet. Sin esto NO conecta.
DB_WALLET_PASSWORD=

# ---- Servidor HTTP -------------------------------------------------
PORT=4000